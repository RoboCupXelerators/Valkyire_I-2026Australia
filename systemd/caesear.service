[Unit]
Description=Caesear main service
After=network.target

[Service]
Type=simple
User=sunrise
WorkingDirectory=/home/user/caesear
# Use bash -lc to source the venv and export env vars before running
ExecStart=/bin/bash -lc 'source /home/user/caesear/venv/bin/activate && export PYTHONUNBUFFERED=1 && exec python -u /home/user/caesear/src/main.py'
Restart=on-failure
RestartSec=5
# write logs to project log files
StandardOutput=append:/home/user/caesear/log/main.log
StandardError=append:/home/user/caesear/log/main.err

[Install]
WantedBy=multi-user.target
